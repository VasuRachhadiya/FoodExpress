@model FoodExpress.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Your Shopping Cart";
}

<div class="container py-5">
    <!-- Conflict Modal / Alert if customer attempted to add dish from another restaurant -->
    @if (TempData["CartConflict"] != null)
    {
        <div class="alert alert-warning border-0 shadow-sm rounded-4 p-4 mb-4">
            <div class="d-flex align-items-center mb-3">
                <i class="bi bi-exclamation-triangle-fill fs-3 text-warning me-3"></i>
                <div>
                    <h5 class="fw-bold mb-0">Different Restaurant Selected</h5>
                    <p class="mb-0 text-secondary">@TempData["CartConflict"]</p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <form asp-action="Add" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="foodItemId" value="@TempData["ConflictFoodItemId"]" />
                    <input type="hidden" name="quantity" value="@TempData["ConflictQuantity"]" />
                    <input type="hidden" name="forceClear" value="true" />
                    <button type="submit" class="btn btn-danger rounded-pill px-4">
                        <i class="bi bi-arrow-repeat me-1"></i> Clear Cart &amp; Add New Dish
                    </button>
                </form>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Keep Existing Items</a>
            </div>
        </div>
    }

    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h1 class="fw-bold mb-1"><i class="bi bi-bag-check-fill text-primary me-2"></i> Your Cart</h1>
            @if (Model.Items.Any())
            {
                <p class="text-muted mb-0">
                    Ordering from: <strong class="text-dark">@Model.RestaurantName</strong>
                </p>
            }
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            @if (Model.Items.Any())
            {
                <form asp-action="Clear" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to empty your entire cart?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                        <i class="bi bi-trash3 me-1"></i> Clear Cart
                    </button>
                </form>
            }
        </div>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm p-5 border">
            <div class="mb-3 text-primary opacity-50">
                <i class="bi bi-cart-x" style="font-size: 5rem;"></i>
            </div>
            <h3 class="fw-bold">Your cart is empty</h3>
            <p class="text-muted mb-4">Looks like you haven't added any delicious dishes yet.</p>
            <a asp-controller="Restaurants" asp-action="Index" class="btn btn-primary rounded-pill px-5 py-2">
                Discover Restaurants &amp; Order
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Cart Items List -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-4">Item</th>
                                    <th scope="col">Price</th>
                                    <th scope="col" style="width: 140px;">Quantity</th>
                                    <th scope="col">Subtotal</th>
                                    <th scope="col" class="text-end pe-4">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <div class="d-flex align-items-center">
                                                <img src="@(string.IsNullOrEmpty(item.FoodImage) ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=100&auto=format&fit=crop&q=80" : item.FoodImage)" 
                                                     alt="@item.FoodName" 
                                                     class="rounded-3 me-3" 
                                                     style="width: 55px; height: 55px; object-fit: cover;" />
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-0">@item.FoodName</h6>
                                                    <span class="text-muted small">@Model.RestaurantName</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="fw-semibold text-secondary">
                                            ₹@item.UnitPrice.ToString("F2")
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center border rounded-pill px-2 py-1 bg-light" style="width: 110px;">
                                                <form asp-action="UpdateQuantity" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                                    <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                                                    <button type="submit" class="btn btn-sm btn-link text-dark p-0 text-decoration-none fw-bold" style="width: 24px;">-</button>
                                                </form>

                                                <span class="mx-auto fw-bold">@item.Quantity</span>

                                                <form asp-action="UpdateQuantity" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                                    <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                                                    <button type="submit" class="btn btn-sm btn-link text-dark p-0 text-decoration-none fw-bold" style="width: 24px;">+</button>
                                                </form>
                                            </div>
                                        </td>
                                        <td class="fw-bold text-dark fs-6">
                                            ₹@item.SubTotal.ToString("F2")
                                        </td>
                                        <td class="text-end pe-4">
                                            <form asp-action="Remove" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger border-0 rounded-circle" title="Remove Item">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-3">
                    <a asp-controller="Restaurants" asp-action="Details" asp-route-id="@Model.RestaurantId" class="text-decoration-none text-primary fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i> Add more items from @Model.RestaurantName
                    </a>
                </div>
            </div>

            <!-- Order Summary & Coupon -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                    <h5 class="fw-bold mb-3">Order Summary</h5>

                    <!-- Coupon Input Form -->
                    <form asp-action="Index" method="get" class="mb-4">
                        <label class="form-label small fw-semibold">Have a Promo Coupon?</label>
                        <div class="input-group">
                            <input type="text" name="couponCode" value="@Model.CouponCode" class="form-control text-uppercase" placeholder="e.g. SAVE15" />
                            <button type="submit" class="btn btn-outline-primary px-3">Apply</button>
                        </div>
                        <div class="form-text small text-muted">Try coupon <strong>SAVE15</strong> or <strong>WELCOME10</strong></div>
                    </form>

                    <div class="d-flex justify-content-between mb-2 small text-secondary">
                        <span>Items Subtotal</span>
                        <span class="fw-semibold text-dark">₹@Model.SubTotal.ToString("F2")</span>
                    </div>

                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 small text-success">
                            <span>Discount (@Model.CouponCode)</span>
                            <span class="fw-semibold">-₹@Model.DiscountAmount.ToString("F2")</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between mb-3 small text-secondary">
                        <span>Estimated Delivery Fee</span>
                        <span class="fw-semibold text-dark">₹@Model.DeliveryFee.ToString("F2")</span>
                    </div>

                    <hr class="my-3" />

                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold fs-5 text-dark">Total Amount</span>
                        <span class="fw-extrabold fs-4 text-primary">₹@Model.TotalAmount.ToString("F2")</span>
                    </div>

                    <a asp-controller="Checkout" asp-action="Index" asp-route-couponCode="@Model.CouponCode" class="btn btn-primary rounded-pill w-100 py-3 fw-bold shadow">
                        Proceed to Checkout <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>
