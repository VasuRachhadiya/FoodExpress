@model FoodExpress.Models.Address
@{
    ViewData["Title"] = "Edit Delivery Address";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="mb-4">
                <a asp-action="Index" class="text-decoration-none text-muted small"><i class="bi bi-arrow-left"></i> Back to Addresses</a>
                <h2 class="fw-bold mb-1 mt-2">Edit Address</h2>
                <p class="text-muted mb-0">Update delivery address coordinates.</p>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label small fw-semibold">Label / Title</label>
                        <input asp-for="Title" class="form-control rounded-3" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AddressLine" class="form-label small fw-semibold">Street Address</label>
                        <textarea asp-for="AddressLine" class="form-control rounded-3" rows="2" required></textarea>
                        <span asp-validation-for="AddressLine" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-5">
                            <label asp-for="City" class="form-label small fw-semibold">City</label>
                            <input asp-for="City" class="form-control rounded-3" required />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="State" class="form-label small fw-semibold">State / Region</label>
                            <input asp-for="State" class="form-control rounded-3" required />
                            <span asp-validation-for="State" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PostalCode" class="form-label small fw-semibold">Postal Code</label>
                            <input asp-for="PostalCode" class="form-control rounded-3" required />
                            <span asp-validation-for="PostalCode" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label small fw-semibold">Contact Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control rounded-3" required />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="IsDefault" id="isDefaultCheck">
                        <label class="form-check-label small fw-semibold" for="isDefaultCheck">
                            Set as my default delivery address
                        </label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-5 py-2">
                            Update Address
                        </button>
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4 py-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
