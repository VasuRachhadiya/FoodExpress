@model List<FoodExpress.Models.FoodCategory>
@{
    ViewData["Title"] = "Food Categories";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge bg-primary px-3 py-2 rounded-pill fw-bold mb-2">Explore Cuisines</span>
        <h1 class="display-6 fw-bold">All Food Categories</h1>
        <p class="text-muted">Choose your favorite category to explore mouth-watering dishes.</p>
    </div>

    <div class="row g-4">
        @foreach (var cat in Model)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <a asp-controller="Food" asp-action="Index" asp-route-categoryId="@cat.Id" class="card h-100 border-0 shadow-sm rounded-4 text-decoration-none card-hover overflow-hidden text-center bg-white p-4">
                    <div class="mx-auto mb-3 rounded-circle overflow-hidden d-flex align-items-center justify-content-center bg-light shadow-sm" style="width: 100px; height: 100px;">
                        @if (!string.IsNullOrEmpty(cat.Image))
                        {
                            <img src="@cat.Image" alt="@cat.Name" class="w-100 h-100" style="object-fit: cover;" />
                        }
                        else
                        {
                            <i class="bi bi-egg-fried text-primary fs-1"></i>
                        }
                    </div>
                    <h5 class="fw-bold text-dark mb-1">@cat.Name</h5>
                    <p class="text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                        @cat.Description
                    </p>
                    <span class="badge bg-primary-subtle-custom text-primary rounded-pill px-3 py-2 fw-semibold">
                        @cat.FoodItems.Count(f => f.IsAvailable) Available Dishes &rarr;
                    </span>
                </a>
            </div>
        }
    </div>
</div>
