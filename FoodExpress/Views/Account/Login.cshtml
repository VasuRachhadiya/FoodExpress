@model FoodExpress.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="text-center mb-4">
                    <div class="brand-icon mx-auto mb-2 d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle shadow-sm" style="width: 50px; height: 50px;">
                        <i class="bi bi-fire fs-4"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Welcome Back</h3>
                    <p class="text-muted small">Sign in to your FoodExpress account</p>
                </div>

                <!-- Quick Fill Test Logins Helper -->
                <div class="p-3 bg-light rounded-3 mb-4 small">
                    <div class="fw-bold text-dark mb-2"><i class="bi bi-magic me-1 text-primary"></i> Quick Fill Demo Logins:</div>
                    <div class="d-flex flex-wrap gap-1">
                        <button type="button" class="btn btn-xs btn-outline-danger py-1 px-2 small rounded-pill" onclick="quickFill('admin@foodexpress.com', 'Admin@123')">
                            Admin
                        </button>
                        <button type="button" class="btn btn-xs btn-outline-warning py-1 px-2 small rounded-pill text-dark" onclick="quickFill('owner@foodexpress.com', 'Owner@123')">
                            Restaurant Owner
                        </button>
                        <button type="button" class="btn btn-xs btn-outline-success py-1 px-2 small rounded-pill" onclick="quickFill('customer@foodexpress.com', 'Customer@123')">
                            Customer
                        </button>
                    </div>
                </div>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" id="loginEmail" class="form-control border-start-0" placeholder="name@example.com" required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" id="loginPassword" type="password" class="form-control border-start-0" placeholder="••••••••" required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberMeCheck" />
                            <label class="form-check-label small" for="rememberMeCheck">Remember me</label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary rounded-pill w-100 py-2 fw-bold shadow-sm">
                        Sign In
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top small text-muted">
                    Don't have an account yet? 
                    <a asp-action="Register" class="text-primary fw-bold text-decoration-none ms-1">Create Account</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function quickFill(email, pwd) {
            document.getElementById('loginEmail').value = email;
            document.getElementById('loginPassword').value = pwd;
        }
    </script>
}
