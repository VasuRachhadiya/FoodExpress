<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FoodExpress | Fast & Fresh Delivery</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Top announcement / quick demo credentials bar -->
    <div class="demo-topbar py-1 px-3 bg-dark text-light small text-center">
        <div class="container d-flex flex-wrap justify-content-center align-items-center gap-2">
            <span class="badge bg-danger">Demo Logins</span>
            <span><i class="bi bi-shield-check text-warning me-1"></i> Admin: <strong>admin@foodexpress.com</strong> / Admin@123</span>
            <span class="d-none d-md-inline text-secondary">|</span>
            <span><i class="bi bi-shop text-info me-1"></i> Owner: <strong>owner@foodexpress.com</strong> / Owner@123</span>
            <span class="d-none d-md-inline text-secondary">|</span>
            <span><i class="bi bi-person-check text-success me-1"></i> Customer: <strong>customer@foodexpress.com</strong> / Customer@123</span>
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <header class="sticky-top shadow-sm bg-white">
        <nav class="navbar navbar-expand-lg navbar-light py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon me-2 d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-3">
                        <i class="bi bi-fire"></i>
                    </span>
                    <span class="fw-bold tracking-tight text-dark brand-text">Food<span class="text-primary">Express</span></span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-medium">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Restaurants" asp-action="Index">Restaurants</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Food" asp-action="Index">Food Menu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Categories" asp-action="Index">Categories</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <!-- Notification Toast / Alert Messages -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
                <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5 me-2"></i>
                <div class="flex-grow-1">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main View Content -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="app-footer pt-5 pb-4 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center mb-3">
                        <span class="brand-icon me-2 d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-3">
                            <i class="bi bi-fire"></i>
                        </span>
                        <span class="fw-bold fs-4 text-white">Food<span class="text-primary">Express</span></span>
                    </div>
                    <p class="footer-desc small pe-lg-4">
                        Delivering steaming hot, mouthwatering culinary delights right to your doorstep. Experience the easiest food ordering and restaurant management platform.
                    </p>
                    <div class="d-flex gap-2 mt-3">
                        <a href="#" class="btn btn-sm btn-social rounded-circle" title="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="btn btn-sm btn-social rounded-circle" title="Twitter"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="btn btn-sm btn-social rounded-circle" title="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="btn btn-sm btn-social rounded-circle" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="fw-bold text-uppercase text-white tracking-wider mb-3">Explore</h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-2"><a class="footer-link text-decoration-none" asp-controller="Restaurants" asp-action="Index">Restaurants</a></li>
                        <li class="mb-2"><a class="footer-link text-decoration-none" asp-controller="Food" asp-action="Index">Food Menu</a></li>
                        <li class="mb-2"><a class="footer-link text-decoration-none" asp-controller="Categories" asp-action="Index">Categories</a></li>
                        <li class="mb-2"><a class="footer-link text-decoration-none" asp-controller="Home" asp-action="About">Our Story</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="fw-bold text-uppercase text-white tracking-wider mb-3">Support</h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-2"><a class="footer-link text-decoration-none" asp-controller="Home" asp-action="Contact">Help &amp; Support</a></li>
                        <li class="mb-2"><a class="footer-link text-decoration-none" asp-controller="Orders" asp-action="Index">Order Status</a></li>
                        <li class="mb-2"><a class="footer-link text-decoration-none" asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                        <li class="mb-2"><a class="footer-link text-decoration-none" asp-controller="Home" asp-action="Terms">Terms of Service</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h6 class="fw-bold text-uppercase text-white tracking-wider mb-3">Stay Connected</h6>
                    <p class="footer-desc small">Subscribe to get secret discount codes and weekly culinary recommendations.</p>
                    <form class="d-flex gap-2" onsubmit="event.preventDefault(); alert('Subscribed to FoodExpress specials!');">
                        <input type="email" class="form-control form-control-sm footer-input" placeholder="Your email address" required />
                        <button class="btn btn-sm btn-primary px-3 rounded-2 text-nowrap" type="submit">Join</button>
                    </form>
                    <div class="mt-3 footer-contact small">
                        <i class="bi bi-telephone-fill me-1 text-primary"></i> <span class="text-white fw-medium">+91 98765 43210</span>
                    </div>
                </div>
            </div>

            <hr class="border-secondary my-4 opacity-50" />

            <div class="row align-items-center small footer-bottom">
                <div class="col-md-6 text-center text-md-start">
                    &copy; @DateTime.UtcNow.Year FoodExpress Inc. All rights reserved.
                </div>
                <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
                    Built with ASP.NET Core 9 MVC, EF Core &amp; SQL Server.
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom App JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
