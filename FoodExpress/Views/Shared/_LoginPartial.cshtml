@using Microsoft.AspNetCore.Identity
@using FoodExpress.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-lg-center gap-2 mt-3 mt-lg-0">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var roles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();

    @if (roles.Contains("Admin"))
    {
        <li class="nav-item">
            <a class="btn btn-sm btn-outline-danger fw-semibold rounded-pill px-3 w-100 text-center" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-shield-lock-fill me-1"></i> Admin Panel
            </a>
        </li>
    }
    else if (roles.Contains("RestaurantOwner"))
    {
        <li class="nav-item">
            <a class="btn btn-sm btn-outline-warning fw-semibold rounded-pill px-3 w-100 text-center" asp-area="Owner" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-shop me-1"></i> Owner Portal
            </a>
        </li>
    }

    <!-- Cart Button with live counter -->
    <li class="nav-item">
        <a class="btn btn-sm btn-primary position-relative rounded-pill px-3 shadow-sm w-100 text-center" asp-area="" asp-controller="Cart" asp-action="Index" id="navCartBtn">
            <i class="bi bi-bag-fill me-1"></i> Cart
            <span class="badge bg-danger rounded-pill ms-1" id="cartCountBadge">0</span>
        </a>
    </li>

    <!-- User Profile Dropdown -->
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center text-dark fw-medium py-2 px-1" href="#" id="userMenuDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="user-avatar-sm me-2">
                @if (!string.IsNullOrEmpty(currentUser?.ProfileImage))
                {
                    <img src="@currentUser.ProfileImage" alt="User" class="rounded-circle border shadow-sm" style="width: 32px; height: 32px; object-fit: cover;" />
                }
                else
                {
                    <span class="avatar-placeholder rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 32px; height: 32px; font-size: 14px;">
                        @(currentUser?.FullName?.Length > 0 ? currentUser.FullName.Substring(0, 1).ToUpper() : "U")
                    </span>
                }
            </div>
            <span class="text-truncate" style="max-width: 150px;">@(currentUser?.FullName ?? User.Identity?.Name)</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3" aria-labelledby="userMenuDropdown">
            <li class="px-3 py-2 border-bottom">
                <div class="fw-bold text-truncate">@currentUser?.FullName</div>
                <div class="small text-muted text-truncate">@currentUser?.Email</div>
                @if (roles.Any())
                {
                    <span class="badge bg-secondary mt-1">@roles.FirstOrDefault()</span>
                }
            </li>
            <li><a class="dropdown-item py-2" asp-area="" asp-controller="Orders" asp-action="Index"><i class="bi bi-receipt me-2 text-primary"></i> My Orders</a></li>
            <li><a class="dropdown-item py-2" asp-area="" asp-controller="Addresses" asp-action="Index"><i class="bi bi-geo-alt me-2 text-primary"></i> Saved Addresses</a></li>
            <li><a class="dropdown-item py-2" asp-area="" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-gear me-2 text-primary"></i> Account Settings</a></li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <form class="d-inline" asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item py-2 text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i> Log Out
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="btn btn-sm btn-outline-secondary rounded-pill px-3 w-100 text-dark fw-medium text-center" asp-area="" asp-controller="Account" asp-action="Login">
            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-sm btn-primary rounded-pill px-4 shadow-sm w-100 text-center" asp-area="" asp-controller="Account" asp-action="Register">
            Sign Up
        </a>
    </li>
}
</ul>
