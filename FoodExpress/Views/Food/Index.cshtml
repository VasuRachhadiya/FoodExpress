@model FoodExpress.ViewModels.FoodFilterViewModel
@{
    ViewData["Title"] = "Food Menu & Dishes";
}

<div class="container py-5">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h1 class="fw-bold mb-1">Explore Dishes</h1>
            <p class="text-muted mb-0">Search delicious food items from verified local kitchens.</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">@Model.FoodItems.Count Dishes Found</span>
        </div>
    </div>

    <!-- Filters Accordion / Card -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-5 bg-white">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Search Dish</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control bg-light border-0" placeholder="e.g. Burger, Roll, Alfredo..." />
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-semibold">Category</label>
                <select name="categoryId" class="form-select bg-light border-0">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id" selected="@(cat.Id == Model.CategoryId)">@cat.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-semibold">Restaurant</label>
                <select name="restaurantId" class="form-select bg-light border-0">
                    <option value="">All Restaurants</option>
                    @foreach (var res in Model.Restaurants)
                    {
                        <option value="@res.Id" selected="@(res.Id == Model.RestaurantId)">@res.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold">Sort By</label>
                <select name="sortBy" class="form-select bg-light border-0">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.SortBy))">Newest</option>
                    <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price: Low to High</option>
                    <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price: High to Low</option>
                    <option value="name" selected="@(Model.SortBy == "name")">Alphabetical</option>
                </select>
            </div>

            <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 pt-3 border-top">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="onlyAvailable" value="true" id="availCheck" @(Model.OnlyAvailable == true ? "checked" : "") />
                    <label class="form-check-label small fw-semibold" for="availCheck">
                        Show only currently available dishes
                    </label>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">Reset</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Apply Filters</button>
                </div>
            </div>
        </form>
    </div>

    <!-- Dishes Grid -->
    @if (!Model.FoodItems.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-search fs-1 text-muted"></i>
            <h4 class="fw-bold mt-3">No food items found matching your filters</h4>
            <p class="text-muted">Try adjusting your keywords or clearing selected categories.</p>
            <a asp-action="Index" class="btn btn-primary rounded-pill px-4">View All Menu Items</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.FoodItems)
            {
                <div class="col-sm-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm card-hover">
                        <div class="position-relative">
                            <a asp-action="Details" asp-route-id="@item.Id">
                                <img src="@(string.IsNullOrEmpty(item.Image) ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=500&auto=format&fit=crop&q=80" : item.Image)" 
                                     class="food-card-img-top" 
                                     alt="@item.Name" 
                                     onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=500&auto=format&fit=crop&q=80';" />
                            </a>
                            @if (!string.IsNullOrEmpty(item.Category?.Name))
                            {
                                <span class="badge bg-white text-dark position-absolute top-0 start-0 m-2 px-2 py-1 rounded-pill small shadow-sm fw-semibold">
                                    @item.Category.Name
                                </span>
                            }
                            @if (!item.IsAvailable)
                            {
                                <span class="badge bg-danger position-absolute top-0 end-0 m-2 px-2 py-1 rounded-pill small">
                                    Sold Out
                                </span>
                            }
                        </div>
                        <div class="card-body p-3 d-flex flex-column">
                            <div class="small text-muted mb-1 text-truncate">
                                <i class="bi bi-shop me-1 text-primary"></i>
                                <a asp-controller="Restaurants" asp-action="Details" asp-route-id="@item.RestaurantId" class="text-decoration-none text-muted">
                                    @item.Restaurant?.Name
                                </a>
                            </div>
                            <h6 class="fw-bold text-dark mb-1 text-truncate">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                                    @item.Name
                                </a>
                            </h6>
                            <p class="text-muted small mb-3 flex-grow-1" style="font-size: 0.8rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @item.Description
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                <span class="fw-bold fs-5 text-dark">₹@item.Price.ToString("F2")</span>
                                @if (item.IsAvailable)
                                {
                                    <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="foodItemId" value="@item.Id" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" title="Add to Cart">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-secondary rounded-pill disabled small" disabled>Unavailable</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
