@model FoodExpress.Models.FoodItem
@{
    ViewData["Title"] = Model.Name + " - FoodExpress";
    var relatedItems = ViewBag.RelatedItems as List<FoodExpress.Models.FoodItem> ?? new();
}

<div class="container py-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Food" asp-action="Index" class="text-decoration-none">Food Menu</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row g-5 mb-5">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <img src="@(string.IsNullOrEmpty(Model.Image) ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=700&auto=format&fit=crop&q=80" : Model.Image)" 
                     alt="@Model.Name" 
                     class="img-fluid w-100" 
                     style="max-height: 450px; object-fit: cover;" />
            </div>
        </div>

        <div class="col-lg-6">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-light text-primary border px-3 py-1 rounded-pill fw-semibold">
                    <i class="bi bi-tag-fill me-1"></i> @Model.Category?.Name
                </span>
                <span class="badge @(Model.IsAvailable ? "bg-success" : "bg-danger") px-3 py-1 rounded-pill">
                    @(Model.IsAvailable ? "In Stock" : "Currently Unavailable")
                </span>
            </div>

            <h1 class="display-6 fw-bold mb-2">@Model.Name</h1>

            <!-- Restaurant link -->
            <div class="mb-3 p-2 px-3 bg-light rounded-3 d-inline-flex align-items-center">
                <i class="bi bi-shop text-primary me-2 fs-5"></i>
                <span class="small text-muted me-1">Prepared by:</span>
                <a asp-controller="Restaurants" asp-action="Details" asp-route-id="@Model.RestaurantId" class="fw-bold text-dark text-decoration-none">
                    @Model.Restaurant?.Name
                </a>
            </div>

            <div class="mb-4">
                <span class="display-5 fw-extrabold text-primary">₹@Model.Price.ToString("F2")</span>
            </div>

            <p class="text-secondary lead mb-4 fs-6">
                @Model.Description
            </p>

            @if (Model.IsAvailable)
            {
                <form asp-controller="Cart" asp-action="Add" method="post" class="card border-0 bg-light p-4 rounded-4 mb-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="foodItemId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                    <div class="row align-items-center g-3">
                        <div class="col-auto">
                            <label class="form-label fw-bold mb-0 small">Quantity:</label>
                        </div>
                        <div class="col-auto">
                            <div class="input-group input-group-sm border rounded-pill overflow-hidden bg-white shadow-sm" style="width: 120px;">
                                <button type="button" class="btn btn-light px-2" onclick="changeQuantity('itemQtyInput', -1)">-</button>
                                <input type="number" id="itemQtyInput" name="quantity" value="1" min="1" max="50" class="form-control text-center border-0 fw-bold" />
                                <button type="button" class="btn btn-light px-2" onclick="changeQuantity('itemQtyInput', 1)">+</button>
                            </div>
                        </div>
                        <div class="col-12 col-sm">
                            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 w-100 shadow-sm">
                                <i class="bi bi-cart-plus-fill me-2"></i> Add to Order
                            </button>
                        </div>
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-warning rounded-4 mb-4">
                    <i class="bi bi-exclamation-circle me-2"></i> This item is currently sold out. Please check other delicious options from this restaurant!
                </div>
            }

            <div class="row g-3 text-muted small pt-3 border-top">
                <div class="col-6"><i class="bi bi-check-circle-fill text-success me-2"></i> Freshly made to order</div>
                <div class="col-6"><i class="bi bi-check-circle-fill text-success me-2"></i> Fast, contact-free delivery</div>
                <div class="col-6"><i class="bi bi-check-circle-fill text-success me-2"></i> Eco-friendly packaging</div>
                <div class="col-6"><i class="bi bi-check-circle-fill text-success me-2"></i> 100% Satisfaction guarantee</div>
            </div>
        </div>
    </div>

    <!-- Related Food Items -->
    @if (relatedItems.Any())
    {
        <div class="mt-5 pt-4 border-top">
            <h3 class="fw-bold mb-4">You May Also Like</h3>
            <div class="row g-4">
                @foreach (var item in relatedItems)
                {
                    <div class="col-sm-6 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm card-hover">
                            <a asp-action="Details" asp-route-id="@item.Id">
                                <img src="@(string.IsNullOrEmpty(item.Image) ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=400&auto=format&fit=crop&q=80" : item.Image)" 
                                     class="food-card-img-top" 
                                     alt="@item.Name" />
                            </a>
                            <div class="card-body p-3 d-flex flex-column">
                                <h6 class="fw-bold mb-1 text-truncate">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                                        @item.Name
                                    </a>
                                </h6>
                                <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                    <span class="fw-bold text-dark">₹@item.Price.ToString("F2")</span>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        View
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
