@model FoodExpress.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Account Profile";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <div>
                    <h1 class="fw-bold mb-1"><i class="bi bi-person-gear text-primary me-2"></i> Account Profile</h1>
                    <p class="text-muted mb-0">Update your profile settings and personal details.</p>
                </div>
                <div>
                    <a asp-action="ChangePassword" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                        <i class="bi bi-key-fill me-1"></i> Change Password
                    </a>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <form asp-action="Index" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <!-- Profile Avatar Preview -->
                    <div class="d-flex align-items-center mb-4 pb-4 border-bottom">
                        <div class="me-4">
                            @if (!string.IsNullOrEmpty(Model.ExistingProfileImage))
                            {
                                <img src="@Model.ExistingProfileImage" alt="Profile" class="rounded-circle border shadow-sm" style="width: 80px; height: 80px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fs-2 shadow-sm" style="width: 80px; height: 80px;">
                                    @(Model.FullName.Length > 0 ? Model.FullName.Substring(0, 1).ToUpper() : "U")
                                </div>
                            }
                        </div>
                        <div>
                            <label class="form-label small fw-semibold">Profile Photo</label>
                            <input type="file" asp-for="ProfileImageFile" class="form-control form-control-sm rounded-3" accept="image/*" />
                            <span class="text-muted" style="font-size: 0.75rem;">Supported: JPG, PNG, WEBP (Max 2MB)</span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label small fw-semibold">Full Name</label>
                            <input asp-for="FullName" class="form-control rounded-3" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold">Email Address (Read-only)</label>
                            <input asp-for="Email" class="form-control rounded-3 bg-light" readonly />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label small fw-semibold">Contact Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control rounded-3" required />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label small fw-semibold">Street Address</label>
                        <input asp-for="Address" class="form-control rounded-3" placeholder="123 Main St, Apt 4" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-5">
                            <label asp-for="City" class="form-label small fw-semibold">City</label>
                            <input asp-for="City" class="form-control rounded-3" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="State" class="form-label small fw-semibold">State</label>
                            <input asp-for="State" class="form-control rounded-3" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PostalCode" class="form-label small fw-semibold">Postal Code</label>
                            <input asp-for="PostalCode" class="form-control rounded-3" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary rounded-pill px-5 py-2">
                        Save Profile Changes
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
