@model FoodExpress.Models.Order
@{
    ViewData["Title"] = $"Order Placed - #{Model.Id}";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 text-center bg-white mb-4">
                <div class="mb-3 text-success">
                    <i class="bi bi-check-circle-fill" style="font-size: 4.5rem;"></i>
                </div>
                <span class="badge bg-success bg-opacity-10 text-success fs-6 px-3 py-2 rounded-pill mb-2">Order Confirmed</span>
                <h1 class="display-6 fw-bold mb-2">Thank you for your order!</h1>
                <p class="lead text-muted mb-4">
                    Your order <strong class="text-dark">#@Model.Id</strong> has been sent directly to the kitchen at <strong class="text-primary">@Model.Restaurant?.Name</strong>.
                </p>

                <div class="d-flex justify-content-center gap-3 flex-wrap mb-4">
                    <a asp-controller="Orders" asp-action="Track" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill px-4 py-2 shadow">
                        <i class="bi bi-geo-alt-fill me-1"></i> Track Live Delivery
                    </a>
                    <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                        <i class="bi bi-receipt me-1"></i> View Order Invoice
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-light rounded-pill px-4 py-2">
                        Back to Home
                    </a>
                </div>

                <div class="p-3 bg-light rounded-4 text-start small">
                    <div class="row g-2">
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Delivery Address:</span>
                            <strong class="text-dark">@Model.DeliveryAddress</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Payment:</span>
                            <strong class="text-dark">@Model.PaymentMethod (@Model.PaymentStatus)</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
