@model FoodExpress.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout - Finalize Your Order";
}

<div class="container py-5">
    <div class="mb-4">
        <h1 class="fw-bold mb-1"><i class="bi bi-shield-check text-primary me-2"></i> Checkout</h1>
        <p class="text-muted mb-0">Confirm delivery address and payment to complete your order from <strong>@Model.RestaurantName</strong>.</p>
    </div>

    <form asp-action="PlaceOrder" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CouponCode" />
        <input type="hidden" asp-for="RestaurantId" />
        <input type="hidden" asp-for="RestaurantName" />

        <div class="row g-4">
            <!-- Left Column: Delivery & Payment Details -->
            <div class="col-lg-7">
                <!-- Delivery Address Card -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                    <h5 class="fw-bold mb-3"><i class="bi bi-geo-alt-fill text-danger me-2"></i> 1. Delivery Details</h5>

                    @if (Model.SavedAddresses.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Select from Saved Addresses</label>
                            <select asp-for="SelectedAddressId" class="form-select rounded-3">
                                <option value="">-- Enter Custom / New Address Below --</option>
                                @foreach (var addr in Model.SavedAddresses)
                                {
                                    <option value="@addr.Id" selected="@(addr.Id == Model.SelectedAddressId)">
                                        @addr.Title - @addr.AddressLine, @addr.City (@addr.PhoneNumber)
                                    </option>
                                }
                            </select>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="DeliveryAddress" class="form-label small fw-semibold">Delivery Address <span class="text-danger">*</span></label>
                        <textarea asp-for="DeliveryAddress" class="form-control rounded-3" rows="3" placeholder="Apartment / Suite, Street Address, City, Postal Code" required></textarea>
                        <span asp-validation-for="DeliveryAddress" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label small fw-semibold">Contact Phone Number <span class="text-danger">*</span></label>
                        <input asp-for="PhoneNumber" class="form-control rounded-3" placeholder="e.g. +91 98765 43210" required />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-0">
                        <label asp-for="OrderNotes" class="form-label small fw-semibold">Kitchen / Delivery Instructions (Optional)</label>
                        <textarea asp-for="OrderNotes" class="form-control rounded-3" rows="2" placeholder="e.g. Please ring doorbell, leave at door, no spicy sauce"></textarea>
                    </div>
                </div>

                <!-- Payment Method Card -->
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h5 class="fw-bold mb-3"><i class="bi bi-credit-card-2-front-fill text-success me-2"></i> 2. Payment Method</h5>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-check p-3 border rounded-3 h-100 bg-light">
                                <input class="form-check-input ms-0 me-2" type="radio" asp-for="PaymentMethod" value="@FoodExpress.Models.PaymentMethod.CashOnDelivery" id="payCod" checked>
                                <label class="form-check-label fw-bold d-block" for="payCod">
                                    <i class="bi bi-cash-stack text-success me-1"></i> Cash on Delivery
                                    <span class="d-block small fw-normal text-muted mt-1">Pay with cash when your food arrives at your door.</span>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check p-3 border rounded-3 h-100 bg-light">
                                <input class="form-check-input ms-0 me-2" type="radio" asp-for="PaymentMethod" value="@FoodExpress.Models.PaymentMethod.OnlineSimulated" id="payOnline">
                                <label class="form-check-label fw-bold d-block" for="payOnline">
                                    <i class="bi bi-credit-card text-primary me-1"></i> Card / Online (Instant Simulation)
                                    <span class="d-block small fw-normal text-muted mt-1">Instant simulated payment clearance for seamless testing.</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Order Review & Pricing Breakdown -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-lg-top" style="top: 80px;">
                    <h5 class="fw-bold mb-3">Order Summary</h5>

                    <div class="mb-3 border-bottom pb-3">
                        <div class="text-muted small">Kitchen:</div>
                        <h6 class="fw-bold text-dark mb-0">@Model.RestaurantName</h6>
                    </div>

                    <!-- Items list -->
                    <div class="mb-3 max-vh-40 overflow-auto">
                        @foreach (var item in Model.Items)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2 small">
                                <div class="text-truncate me-2">
                                    <span class="fw-bold text-dark">@item.Quantity x</span>
                                    <span>@item.FoodName</span>
                                </div>
                                <span class="fw-semibold text-dark text-nowrap">₹@item.SubTotal.ToString("F2")</span>
                            </div>
                        }
                    </div>

                    <hr class="my-3" />

                    <div class="d-flex justify-content-between mb-2 small text-secondary">
                        <span>Subtotal</span>
                        <span class="fw-semibold text-dark">₹@Model.SubTotal.ToString("F2")</span>
                    </div>

                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 small text-success">
                            <span>Promo Discount (@Model.CouponCode)</span>
                            <span class="fw-semibold">-₹@Model.DiscountAmount.ToString("F2")</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between mb-3 small text-secondary">
                        <span>Delivery Fee</span>
                        <span class="fw-semibold text-dark">₹@Model.DeliveryFee.ToString("F2")</span>
                    </div>

                    <hr class="my-3" />

                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold fs-5 text-dark">Total Amount</span>
                        <span class="fw-extrabold fs-4 text-primary">₹@Model.TotalAmount.ToString("F2")</span>
                    </div>

                    <button type="submit" class="btn btn-primary rounded-pill w-100 py-3 fw-bold shadow">
                        <i class="bi bi-bag-check me-2"></i> Place Order Now
                    </button>

                    <p class="text-center text-muted small mt-3 mb-0">
                        <i class="bi bi-lock-fill me-1"></i> Safe &amp; encrypted checkout
                    </p>
                </div>
            </div>
        </div>
    </form>
</div>
