@model FoodExpress.Models.Restaurant
@{
    ViewData["Title"] = Model.Name + " - Menu & Reviews";
    var groupedMenu = ViewBag.GroupedMenu as Dictionary<string, List<FoodExpress.Models.FoodItem>> ?? new();
}

<!-- Restaurant Header Hero -->
<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="position-relative">
            <img src="@(string.IsNullOrEmpty(Model.Image) ? "https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=1200&auto=format&fit=crop&q=80" : Model.Image)" 
                 alt="@Model.Name" 
                 class="restaurant-banner-img" />
            <div class="position-absolute bottom-0 start-0 end-0 p-4 p-md-5 text-white" style="background: linear-gradient(to top, rgba(0,0,0,0.85), transparent);">
                <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                    <div>
                        <span class="badge bg-primary px-3 py-1 rounded-pill mb-2"><i class="bi bi-clock me-1"></i> Open: @Model.OpeningTime.ToString(@"hh\:mm") - @Model.ClosingTime.ToString(@"hh\:mm")</span>
                        <h1 class="display-5 fw-bold text-white mb-2">@Model.Name</h1>
                        <p class="mb-0 text-light opacity-90"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.Address, @Model.City &bull; <i class="bi bi-telephone-fill text-success ms-2 me-1"></i> @Model.FormattedPhone</p>
                    </div>
                    <div class="text-md-end">
                        @if (Model.Rating > 0)
                        {
                            <div class="badge bg-warning text-dark fs-5 px-3 py-2 rounded-pill fw-bold shadow">
                                <i class="bi bi-star-fill text-dark me-1"></i> @Model.Rating.ToString("0.0") / 5.0
                            </div>
                        }
                        <div class="text-light small mt-1">@Model.Reviews.Count(r => r.IsApproved) customer review(s)</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="p-4 bg-white border-bottom">
            <p class="text-secondary mb-0">@Model.Description</p>
        </div>
    </div>

    <!-- Menu Sections -->
    <div class="row">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold mb-0">Explore the Menu</h3>
                <span class="text-muted small">@Model.FoodItems.Count(f => f.IsAvailable) items currently available</span>
            </div>

            @if (!groupedMenu.Any())
            {
                <div class="alert alert-info rounded-4 border-0">
                    <i class="bi bi-info-circle me-2"></i> No active dishes currently listed for this restaurant. Please check back later!
                </div>
            }
            else
            {
                @foreach (var group in groupedMenu)
                {
                    <div class="mb-5">
                        <h4 class="fw-bold text-dark border-bottom pb-2 mb-3">
                            <i class="bi bi-tag-fill text-primary me-2"></i> @group.Key
                        </h4>
                        <div class="row g-3">
                            @foreach (var item in group.Value)
                            {
                                <div class="col-md-6">
                                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden card-hover">
                                        <div class="d-flex h-100">
                                            <div style="width: 120px; min-width: 120px;" class="position-relative">
                                                <img src="@(string.IsNullOrEmpty(item.Image) ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=300&auto=format&fit=crop&q=80" : item.Image)" 
                                                     alt="@item.Name" 
                                                     class="h-100 w-100" 
                                                     style="object-fit: cover;" 
                                                     onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=300&auto=format&fit=crop&q=80';" />
                                            </div>
                                            <div class="p-3 d-flex flex-column flex-grow-1">
                                                <h6 class="fw-bold mb-1 text-dark">
                                                    <a asp-controller="Food" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                                                        @item.Name
                                                    </a>
                                                </h6>
                                                <p class="text-muted small mb-2 flex-grow-1" style="font-size: 0.78rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                                    @item.Description
                                                </p>
                                                <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                                    <span class="fw-bold text-primary fs-6">₹@item.Price.ToString("F2")</span>
                                                    @if (item.IsAvailable)
                                                    {
                                                        <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="foodItemId" value="@item.Id" />
                                                            <input type="hidden" name="quantity" value="1" />
                                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                            <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 py-1">
                                                                <i class="bi bi-cart-plus me-1"></i> Add
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Sold Out</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Sidebar: Reviews & Submit Feedback -->
        <div class="col-lg-4">
            <div class="sticky-lg-top" style="top: 80px;">
                <!-- Review Form Card -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                    <h5 class="fw-bold mb-3"><i class="bi bi-star-half text-warning me-2"></i> Leave a Review</h5>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Reviews" asp-action="Create" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="restaurantId" value="@Model.Id" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold small">Rating</label>
                                <select name="rating" class="form-select rounded-3">
                                    <option value="5">⭐⭐⭐⭐⭐ (5 - Exceptional)</option>
                                    <option value="4">⭐⭐⭐⭐ (4 - Very Good)</option>
                                    <option value="3">⭐⭐⭐ (3 - Average)</option>
                                    <option value="2">⭐⭐ (2 - Below Expectations)</option>
                                    <option value="1">⭐ (1 - Poor)</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold small">Your Experience</label>
                                <textarea name="comment" class="form-control rounded-3" rows="3" placeholder="Tell us how the food and service was..." required></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary rounded-pill w-100 py-2">
                                Submit Review
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <p class="text-muted small mb-3">Please sign in to share your dining review with other customers.</p>
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-outline-primary rounded-pill px-4 btn-sm">
                                Sign In to Review
                            </a>
                        </div>
                    }
                </div>

                <!-- Recent Reviews List -->
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h5 class="fw-bold mb-3">Customer Feedback</h5>
                    @if (!Model.Reviews.Any(r => r.IsApproved))
                    {
                        <p class="text-muted small mb-0">No reviews yet. Be the first to review this restaurant!</p>
                    }
                    else
                    {
                        <div class="review-list">
                            @foreach (var rev in Model.Reviews.Where(r => r.IsApproved).OrderByDescending(r => r.CreatedDate).Take(5))
                            {
                                <div class="border-bottom pb-3 mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold small text-dark">@(rev.User?.FullName ?? "Customer")</span>
                                        <span class="text-warning small">
                                            @for (int i = 0; i < rev.Rating; i++)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                        </span>
                                    </div>
                                    <p class="text-secondary small mb-1">@rev.Comment</p>
                                    <span class="text-muted" style="font-size: 0.75rem;">@rev.CreatedDate.ToString("dd MMM yyyy")</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
