@{
    ViewData["Title"] = "Contact Us";
}

<div class="container py-5">
    <div class="row g-5">
        <div class="col-lg-6">
            <span class="badge bg-primary text-white rounded-pill px-3 py-2 mb-2">Get in Touch</span>
            <h1 class="display-6 fw-bold mb-3">We’d love to hear from you!</h1>
            <p class="text-muted mb-4">
                Have questions regarding your order, eager to partner your restaurant with FoodExpress, or just want to share your thoughts? Drop us a line!
            </p>

            <div class="d-flex mb-3 align-items-start">
                <div class="bg-light text-primary rounded-circle p-3 me-3 fs-5">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Headquarters</h6>
                    <p class="text-muted small mb-0">Connaught Place, New Delhi, Delhi 110001, India</p>
                </div>
            </div>

            <div class="d-flex mb-3 align-items-start">
                <div class="bg-light text-primary rounded-circle p-3 me-3 fs-5">
                    <i class="bi bi-telephone-fill"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Customer Support Line</h6>
                    <p class="text-muted small mb-0">1800-123-4567 / +91 98765 43210 (Toll Free 24/7)</p>
                </div>
            </div>

            <div class="d-flex mb-3 align-items-start">
                <div class="bg-light text-primary rounded-circle p-3 me-3 fs-5">
                    <i class="bi bi-envelope-fill"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Email Inquiries</h6>
                    <p class="text-muted small mb-0">support@foodexpress.com</p>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <h4 class="fw-bold mb-3">Send a Message</h4>
                <form onsubmit="event.preventDefault(); alert('Thank you for reaching out! Our support team will reply within 24 hours.'); this.reset();">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Your Name</label>
                        <input type="text" class="form-control rounded-3" placeholder="John Doe" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address</label>
                        <input type="email" class="form-control rounded-3" placeholder="name@example.com" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Subject</label>
                        <input type="text" class="form-control rounded-3" placeholder="Question about an order / Partnership" required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Message</label>
                        <textarea class="form-control rounded-3" rows="4" placeholder="How can we assist you today?" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 w-100">
                        <i class="bi bi-send-fill me-1"></i> Send Inquiry
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
