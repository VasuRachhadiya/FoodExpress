@{
    ViewData["Title"] = "About Us";
}

<div class="container py-5">
    <div class="row align-items-center mb-5">
        <div class="col-lg-6">
            <span class="badge bg-primary text-white rounded-pill px-3 py-2 mb-2">Our Mission</span>
            <h1 class="display-5 fw-bold mb-3">Connecting Food Lovers With Exceptional Kitchens</h1>
            <p class="lead text-muted">
                FoodExpress was born from a simple belief: high quality, chef-crafted food should be accessible to everyone, anywhere, anytime.
            </p>
            <p class="text-secondary">
                We partner with passionate local restaurateurs and renowned eateries to bring a rich variety of cuisines right to your table. Our intelligent platform enables restaurants to streamline their kitchen operations while guaranteeing customers speedy delivery and transparent tracking.
            </p>
        </div>
        <div class="col-lg-6">
            <img src="https://images.unsplash.com/photo-1556910103-1c02745aae4d?w=600&auto=format&fit=crop&q=80" alt="Kitchen Team" class="img-fluid rounded-4 shadow" />
        </div>
    </div>

    <div class="row g-4 text-center mt-4">
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 shadow-sm h-100 border">
                <div class="text-primary fs-1 mb-3"><i class="bi bi-clock-history"></i></div>
                <h5 class="fw-bold">Lightning-Fast Delivery</h5>
                <p class="text-muted small">Our real-time order tracking and optimized routing ensure your food arrives hot, fresh, and on time.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 shadow-sm h-100 border">
                <div class="text-primary fs-1 mb-3"><i class="bi bi-award-fill"></i></div>
                <h5 class="fw-bold">Top Hygiene & Quality</h5>
                <p class="text-muted small">Every restaurant partner is vetted for culinary quality, strict cleanliness standards, and authentic flavor.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 shadow-sm h-100 border">
                <div class="text-primary fs-1 mb-3"><i class="bi bi-shield-lock-fill"></i></div>
                <h5 class="fw-bold">Secure Transactions</h5>
                <p class="text-muted small">Enjoy flexible payment options including simulated instant card payments and Cash on Delivery.</p>
            </div>
        </div>
    </div>
</div>
