@{
    ViewData["Title"] = "Terms of Service";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h1 class="fw-bold mb-4">Terms of Service</h1>
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
                <h4 class="fw-bold">1. Order Placement &amp; Restaurant Terms</h4>
                <p class="text-secondary">
                    All orders placed through FoodExpress are subject to food item availability and restaurant acceptance. Because our delivery fleet specializes in single-kitchen precision, orders in a single checkout session must originate from one restaurant.
                </p>

                <h4 class="fw-bold mt-4">2. Cancellation Policy</h4>
                <p class="text-secondary">
                    Customers may freely cancel orders while they remain in <em>Pending</em> status. Once a restaurant confirms and begins preparing the dish, cancellation is restricted to avoid food waste.
                </p>

                <h4 class="fw-bold mt-4">3. Fair Use &amp; Community Guidelines</h4>
                <p class="text-secondary">
                    Customer reviews and ratings must reflect genuine dining experiences. Abusive language, fraudulent reviews, or coupon abuse will result in immediate account suspension.
                </p>
            </div>
        </div>
    </div>
</div>
