@model FoodExpress.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Fast Food Delivery To Your Door";
}

<!-- Hero Section -->
<section class="py-5">
    <div class="container">
        <div class="hero-banner p-4 p-md-5 text-white shadow-lg">
            <div class="row align-items-center position-relative" style="z-index: 2;">
                <div class="col-lg-7">
                    <span class="badge bg-danger text-uppercase px-3 py-2 rounded-pill fw-bold mb-3">
                        <i class="bi bi-lightning-charge-fill me-1"></i> Fast Delivery within 30 mins
                    </span>
                    <h1 class="display-4 fw-extrabold mb-3 text-white lh-tight">
                        Crave it? Get it.<br />
                        <span class="text-warning">Delicious food</span> delivered hot.
                    </h1>
                    <p class="lead text-light opacity-75 mb-4">
                        Order from top rated local restaurants, track your delivery in real-time, and savor delicious dishes at your fingertips.
                    </p>

                    <!-- Search Form -->
                    <form asp-controller="Food" asp-action="Index" method="get" class="search-pill d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-search text-muted fs-5 ms-3"></i>
                        <input type="text" name="search" class="form-control border-0 shadow-none" placeholder="Search pizza, sushi, burgers, pasta..." />
                        <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 text-nowrap">Find Food</button>
                    </form>

                    <div class="d-flex align-items-center flex-wrap gap-2 gap-md-3 text-light small opacity-75">
                        <span><i class="bi bi-check-circle-fill text-success me-1"></i> Live Order Tracking</span>
                        <span><i class="bi bi-check-circle-fill text-success me-1"></i> No Hidden Fees</span>
                        <span><i class="bi bi-check-circle-fill text-success me-1"></i> Verified Restaurants</span>
                    </div>
                </div>

                <div class="col-lg-5 d-none d-lg-block text-center">
                    <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=600&auto=format&fit=crop&q=80" 
                         alt="Delicious Spread" 
                         class="img-fluid rounded-4 shadow-lg border border-4 border-white" 
                         style="max-height: 380px; object-fit: cover; transform: rotate(1.5deg);" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Food Categories -->
<section class="py-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <span class="text-primary fw-bold text-uppercase small tracking-wider">Flavors &amp; Cuisines</span>
                <h2 class="fw-bold mb-0">Browse by Category</h2>
            </div>
            <a asp-controller="Categories" asp-action="Index" class="text-primary fw-semibold text-decoration-none">
                View All <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="row g-3">
            @foreach (var cat in Model.Categories)
            {
                <div class="col-6 col-md-4 col-lg-2">
                    <a asp-controller="Food" asp-action="Index" asp-route-categoryId="@cat.Id" class="card text-decoration-none border-0 shadow-sm text-center p-3 h-100 card-hover bg-white">
                        <div class="mx-auto mb-2 rounded-circle overflow-hidden d-flex align-items-center justify-content-center bg-light" style="width: 70px; height: 70px;">
                            @if (!string.IsNullOrEmpty(cat.Image))
                            {
                                <img src="@cat.Image" alt="@cat.Name" class="img-fluid" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <i class="bi bi-egg-fried text-primary fs-2"></i>
                            }
                        </div>
                        <h6 class="fw-bold text-dark mb-1">@cat.Name</h6>
                        <span class="badge bg-light text-muted small">@cat.FoodItems.Count dishes</span>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- Featured Restaurants -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <span class="text-primary fw-bold text-uppercase small tracking-wider">Top Rated</span>
                <h2 class="fw-bold mb-0">Popular Restaurants</h2>
            </div>
            <a asp-controller="Restaurants" asp-action="Index" class="text-primary fw-semibold text-decoration-none">
                Explore All Restaurants <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="row g-4">
            @foreach (var restaurant in Model.FeaturedRestaurants)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm card-hover overflow-hidden">
                        <div class="position-relative">
                            <img src="@(string.IsNullOrEmpty(restaurant.Image) ? "https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=500&auto=format&fit=crop&q=80" : restaurant.Image)" 
                                 class="card-img-top" 
                                 alt="@restaurant.Name" 
                                 style="height: 190px; object-fit: cover;" />
                            <span class="badge bg-dark bg-opacity-75 text-white position-absolute top-0 start-0 m-3 px-2 py-1 rounded-pill small">
                                <i class="bi bi-clock me-1"></i> @restaurant.OpeningTime.ToString(@"hh\:mm") - @restaurant.ClosingTime.ToString(@"hh\:mm")
                            </span>
                            @if (restaurant.Rating > 0)
                            {
                                <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-3 px-2 py-1 rounded-pill fw-bold shadow-sm">
                                    <i class="bi bi-star-fill text-dark me-1"></i> @restaurant.Rating.ToString("0.0")
                                </span>
                            }
                        </div>
                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="fw-bold text-dark mb-1">@restaurant.Name</h5>
                            <p class="text-muted small mb-2"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @restaurant.City, @restaurant.Address</p>
                            <p class="card-text text-secondary small line-clamp-2 flex-grow-1">@restaurant.Description</p>
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                <span class="small text-muted"><i class="bi bi-telephone me-1"></i> @restaurant.FormattedPhone</span>
                                <a asp-controller="Restaurants" asp-action="Details" asp-route-id="@restaurant.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    View Menu
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Popular Dishes -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <span class="text-primary fw-bold text-uppercase small tracking-wider">Chef's Recommendations</span>
                <h2 class="fw-bold mb-0">Trending Food Items</h2>
            </div>
            <a asp-controller="Food" asp-action="Index" class="text-primary fw-semibold text-decoration-none">
                Browse Full Menu <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="row g-4">
            @foreach (var item in Model.PopularFoodItems)
            {
                <div class="col-sm-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm card-hover">
                        <div class="position-relative">
                            <img src="@(string.IsNullOrEmpty(item.Image) ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=500&auto=format&fit=crop&q=80" : item.Image)" 
                                 class="food-card-img-top" 
                                 alt="@item.Name" 
                                 onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=500&auto=format&fit=crop&q=80';" />
                            @if (!string.IsNullOrEmpty(item.Category?.Name))
                            {
                                <span class="badge bg-white text-dark position-absolute top-0 start-0 m-2 px-2 py-1 rounded-pill small shadow-sm fw-semibold">
                                    @item.Category.Name
                                </span>
                            }
                            @if (!item.IsAvailable)
                            {
                                <span class="badge bg-danger position-absolute top-0 end-0 m-2 px-2 py-1 rounded-pill small">
                                    Sold Out
                                </span>
                            }
                        </div>
                        <div class="card-body p-3 d-flex flex-column">
                            <div class="small text-muted mb-1 text-truncate">
                                <i class="bi bi-shop me-1 text-primary"></i> @item.Restaurant?.Name
                            </div>
                            <h6 class="fw-bold text-dark mb-1 text-truncate">@item.Name</h6>
                            <p class="text-muted small mb-3 flex-grow-1" style="font-size: 0.8rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @item.Description
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                <span class="fw-bold fs-5 text-dark">₹@item.Price.ToString("F2")</span>
                                @if (item.IsAvailable)
                                {
                                    <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="foodItemId" value="@item.Id" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" title="Add to Cart">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-secondary rounded-pill disabled small" disabled>Unavailable</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Active Promo Banner -->
@if (Model.ActiveCoupons.Any())
{
    <section class="py-4">
        <div class="container">
            <div class="p-4 rounded-4 text-white shadow" style="background: linear-gradient(135deg, #1e90ff, #70a1ff);">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <span class="badge bg-warning text-dark fw-bold mb-2">HOT DISCOUNT</span>
                        <h3 class="fw-bold text-white mb-1">Save with our exclusive coupons!</h3>
                        <p class="mb-md-0 text-white-50">
                            Apply promo code <span class="badge bg-white text-primary fs-6 px-3 py-1 fw-bold">@Model.ActiveCoupons.First().Code</span> at checkout to get 
                            @(Model.ActiveCoupons.First().DiscountType == DiscountType.Percentage ? $"{Model.ActiveCoupons.First().DiscountValue}% off" : $"₹{Model.ActiveCoupons.First().DiscountValue:F2} off")!
                        </p>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <a asp-controller="Food" asp-action="Index" class="btn btn-light text-primary fw-bold rounded-pill px-4 py-2 shadow-sm">
                            Order Now
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
