@model List<FoodExpress.Models.FoodCategory>
@{
    ViewData["Title"] = "Food Categories";
}

<div class="py-2">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">Food Categories</h2>
            <p class="text-muted mb-0">Organize food items into discoverable menu categories.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-plus-lg me-1"></i> Add Category
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Category</th>
                        <th>Description</th>
                        <th>Total Dishes</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-3 overflow-hidden me-3 d-flex align-items-center justify-content-center bg-light" style="width: 50px; height: 50px;">
                                        @if (!string.IsNullOrEmpty(cat.Image))
                                        {
                                            <img src="@cat.Image" alt="@cat.Name" class="w-100 h-100" style="object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-tag text-primary fs-4"></i>
                                        }
                                    </div>
                                    <div class="fw-bold text-dark fs-6">@cat.Name</div>
                                </div>
                            </td>
                            <td class="small text-muted" style="max-width: 350px;">
                                @(cat.Description ?? "No description provided.")
                            </td>
                            <td>
                                <span class="badge bg-light text-primary rounded-pill px-3 py-1 fw-bold">
                                    @cat.FoodItems.Count items
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-sm btn-light rounded-pill px-3" title="Edit Category">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@cat.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this category? Associated food items will need reassignment.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Delete">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
