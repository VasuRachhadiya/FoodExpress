@model FoodExpress.Models.FoodCategory
@{
    ViewData["Title"] = $"Edit Category - {Model.Name}";
}

<div class="py-2">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="mb-4">
                <a asp-action="Index" class="text-decoration-none text-muted small"><i class="bi bi-arrow-left"></i> Back to Categories</a>
                <h2 class="fw-bold mb-1 mt-2">Edit Category</h2>
                <p class="text-muted mb-0">Update information for category @Model.Name.</p>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label small fw-semibold">Category Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control rounded-3" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label small fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="3"></textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold">Category Icon / Image</label>
                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <div class="mb-2">
                                <img src="@Model.Image" alt="@Model.Name" class="rounded-3" style="width: 80px; height: 80px; object-fit: cover;" />
                            </div>
                        }
                        <input type="file" name="imageFile" class="form-control rounded-3" accept="image/*" />
                        <span class="text-muted small">Select a file to replace current category image</span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-5 py-2">
                            Update Category
                        </button>
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4 py-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
