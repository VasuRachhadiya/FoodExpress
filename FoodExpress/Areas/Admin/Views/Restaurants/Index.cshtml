@model List<FoodExpress.Models.Restaurant>
@{
    ViewData["Title"] = "Manage Restaurants";
}

<div class="py-2">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">Restaurants</h2>
            <p class="text-muted mb-0">Platform restaurant listings, assigned owners, and operations.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-plus-lg me-1"></i> Add Restaurant
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-light border-0" placeholder="Search by restaurant name, city, or owner..." />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill w-100">Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Restaurant</th>
                        <th>Owner</th>
                        <th>Location</th>
                        <th>Hours</th>
                        <th>Rating</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center">
                                    <img src="@(string.IsNullOrEmpty(item.Image) ? "https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=100&auto=format&fit=crop&q=80" : item.Image)" 
                                         alt="@item.Name" 
                                         class="rounded-3 me-3" 
                                         style="width: 50px; height: 50px; object-fit: cover;" />
                                    <div>
                                        <div class="fw-bold text-dark">@item.Name</div>
                                        <span class="text-muted small">@item.FoodItems.Count dishes listed</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark small">@(item.Owner?.FullName ?? "Unassigned")</div>
                                <span class="text-muted" style="font-size: 0.75rem;">@item.Owner?.Email</span>
                            </td>
                            <td class="small text-secondary">
                                @item.City<br />
                                <span class="text-muted">@item.Address</span>
                            </td>
                            <td class="small text-muted">
                                @item.OpeningTime.ToString(@"hh\:mm") - @item.ClosingTime.ToString(@"hh\:mm")
                            </td>
                            <td>
                                <span class="badge bg-warning text-dark rounded-pill">
                                    <i class="bi bi-star-fill text-dark me-1"></i> @item.Rating.ToString("0.0")
                                </span>
                            </td>
                            <td>
                                <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="badge @(item.IsActive ? "bg-success" : "bg-secondary") border-0 rounded-pill px-3 py-1 cursor-pointer">
                                        @(item.IsActive ? "Active" : "Disabled")
                                    </button>
                                </form>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light rounded-pill px-3" title="Edit Restaurant">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this restaurant and all associated menu items?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Delete">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
