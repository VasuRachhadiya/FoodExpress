@model IEnumerable<FoodExpress.Models.Review>
@{
    ViewData["Title"] = "Customer Reviews Moderation";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Customer Reviews</h2>
        <p class="text-muted mb-0">Review customer ratings and moderate public feedback.</p>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Approval Status</label>
                <select name="approved" class="form-select form-select-sm">
                    <option value="">-- All Reviews --</option>
                    <option value="true" selected="@(ViewBag.ApprovedFilter == true)">Approved Only</option>
                    <option value="false" selected="@(ViewBag.ApprovedFilter == false)">Pending / Rejected</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2 mt-auto">
                <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Reviews Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Date</th>
                        <th>Customer</th>
                        <th>Target</th>
                        <th>Rating</th>
                        <th>Comment</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-chat-left-dots fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                No reviews found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var review in Model)
                        {
                            <tr>
                                <td class="ps-4 small text-muted">
                                    @review.CreatedDate.ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@(review.User?.FullName ?? "Anonymous")</div>
                                    <div class="small text-muted">@(review.User?.Email)</div>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark"><i class="bi bi-shop me-1 text-primary"></i> @(review.Restaurant?.Name)</div>
                                    @if (review.FoodItem != null)
                                    {
                                        <div class="small text-muted"><i class="bi bi-egg-fried me-1"></i> @review.FoodItem.Name</div>
                                    }
                                </td>
                                <td>
                                    <div class="text-warning small text-nowrap">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= review.Rating)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-secondary opacity-25"></i>
                                            }
                                        }
                                        <span class="fw-bold text-dark ms-1">(@review.Rating)</span>
                                    </div>
                                </td>
                                <td style="max-width: 320px;">
                                    <p class="mb-0 text-dark small text-break">@review.Comment</p>
                                </td>
                                <td>
                                    @if (review.IsApproved)
                                    {
                                        <span class="badge bg-success rounded-pill px-2 py-1">Approved</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-2 py-1">Pending</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <form asp-action="ToggleApproval" asp-route-id="@review.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(review.IsApproved ? "btn-outline-warning" : "btn-outline-success") rounded-pill px-2">
                                                @(review.IsApproved ? "Revoke" : "Approve")
                                            </button>
                                        </form>
                                        <form asp-action="Delete" asp-route-id="@review.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this review permanently?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
