@model List<(FoodExpress.Models.ApplicationUser User, IList<string> Roles)>
@{
    ViewData["Title"] = "User & Role Management";
    var allRoles = ViewBag.AllRoles as List<string> ?? new();
}

<div class="py-2">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">Users &amp; Roles</h2>
            <p class="text-muted mb-0">Manage registered platform accounts, access roles, and account statuses.</p>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-7">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-light border-0" placeholder="Search by name, email, or phone..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="roleFilter" class="form-select bg-light border-0">
                    <option value="">All Roles</option>
                    @foreach (var r in allRoles)
                    {
                        <option value="@r" selected="@(ViewBag.RoleFilter == r)">@r</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>

    <!-- Users Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">User</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Roles</th>
                        <th>Status</th>
                        <th>Joined</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center me-2 fw-bold" style="width: 36px; height: 36px; font-size: 14px;">
                                        @(item.User.FullName.Length > 0 ? item.User.FullName.Substring(0, 1).ToUpper() : "U")
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@item.User.FullName</div>
                                    </div>
                                </div>
                            </td>
                            <td class="small text-secondary">@item.User.Email</td>
                            <td class="small text-muted">@(item.User.PhoneNumber ?? "—")</td>
                            <td>
                                @foreach (var r in item.Roles)
                                {
                                    <span class="badge @(r == "Admin" ? "bg-danger" : (r == "RestaurantOwner" ? "bg-warning text-dark" : "bg-info text-dark")) rounded-pill me-1">
                                        @r
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="badge @(item.User.IsActive ? "bg-success" : "bg-secondary") rounded-pill">
                                    @(item.User.IsActive ? "Active" : "Deactivated")
                                </span>
                            </td>
                            <td class="small text-muted">@item.User.CreatedDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@item.User.Id" class="btn btn-sm btn-light rounded-pill px-3" title="View Profile & Manage Role">
                                        Manage
                                    </a>
                                    <form asp-action="ToggleStatus" asp-route-id="@item.User.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(item.User.IsActive ? "btn-outline-danger" : "btn-outline-success") rounded-pill px-2" title="@(item.User.IsActive ? "Deactivate User" : "Activate User")">
                                            <i class="bi @(item.User.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
