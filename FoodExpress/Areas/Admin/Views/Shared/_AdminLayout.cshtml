<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FoodExpress Admin</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Sidebar -->
            <div class="col-lg-2 dashboard-sidebar p-3 d-none d-lg-block">
                <div class="d-flex align-items-center mb-4 px-2 pt-2">
                    <span class="brand-icon me-2 d-inline-flex align-items-center justify-content-center bg-danger text-white rounded-3">
                        <i class="bi bi-shield-lock-fill"></i>
                    </span>
                    <div>
                        <div class="fw-bold text-dark fs-5 lh-1">Food<span class="text-danger">Express</span></div>
                        <span class="badge bg-danger rounded-pill mt-1" style="font-size: 0.65rem;">ADMIN CONTROL</span>
                    </div>
                </div>

                <nav class="nav flex-column mb-4">
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid-1x2-fill"></i> Dashboard
                    </a>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Restaurants" ? "active" : "")" asp-area="Admin" asp-controller="Restaurants" asp-action="Index">
                        <i class="bi bi-shop"></i> Restaurants
                    </a>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                        <i class="bi bi-tags-fill"></i> Categories
                    </a>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "FoodItems" ? "active" : "")" asp-area="Admin" asp-controller="FoodItems" asp-action="Index">
                        <i class="bi bi-egg-fried"></i> Food Items
                    </a>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                        <i class="bi bi-receipt"></i> Orders
                    </a>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")" asp-area="Admin" asp-controller="Users" asp-action="Index">
                        <i class="bi bi-people-fill"></i> Users &amp; Roles
                    </a>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Coupons" ? "active" : "")" asp-area="Admin" asp-controller="Coupons" asp-action="Index">
                        <i class="bi bi-ticket-perforated-fill"></i> Coupons
                    </a>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reviews" ? "active" : "")" asp-area="Admin" asp-controller="Reviews" asp-action="Index">
                        <i class="bi bi-star-half"></i> Reviews
                    </a>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" asp-area="Admin" asp-controller="Reports" asp-action="Index">
                        <i class="bi bi-graph-up-arrow"></i> Sales Reports
                    </a>
                </nav>

                <div class="mt-auto px-2 pt-4 border-top">
                    <a class="btn btn-outline-dark btn-sm rounded-pill w-100 mb-2" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-arrow-left me-1"></i> Public Website
                    </a>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill w-100">
                            <i class="bi bi-box-arrow-right me-1"></i> Log Out
                        </button>
                    </form>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="col-lg-10 min-vh-100 d-flex flex-column">
                <!-- Topbar -->
                <header class="bg-white border-bottom py-3 px-4 sticky-top">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <button class="btn btn-light d-lg-none me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminMobileSidebar">
                                <i class="bi bi-list fs-4"></i>
                            </button>
                            <h5 class="fw-bold mb-0 text-dark">Admin Console</h5>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-light rounded-pill px-3">
                                <i class="bi bi-globe me-1"></i> View Live Site
                            </a>
                            <span class="text-muted small">Logged in as: <strong>@User.Identity?.Name</strong></span>
                        </div>
                    </div>
                </header>

                <!-- Notifications -->
                <div class="px-4 pt-3">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
                            <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                </div>

                <!-- Page Content -->
                <main class="flex-grow-1 px-3 px-md-4 py-3">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <!-- Admin Mobile Offcanvas Sidebar -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="adminMobileSidebar" aria-labelledby="adminMobileSidebarLabel">
        <div class="offcanvas-header border-bottom">
            <div class="d-flex align-items-center">
                <span class="brand-icon me-2 d-inline-flex align-items-center justify-content-center bg-danger text-white rounded-3">
                    <i class="bi bi-shield-lock-fill"></i>
                </span>
                <div>
                    <div class="fw-bold text-dark fs-5 lh-1" id="adminMobileSidebarLabel">Food<span class="text-danger">Express</span></div>
                    <span class="badge bg-danger rounded-pill mt-1" style="font-size: 0.65rem;">ADMIN CONTROL</span>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column p-3">
            <nav class="nav flex-column mb-4">
                <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-grid-1x2-fill"></i> Dashboard
                </a>
                <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Restaurants" ? "active" : "")" asp-area="Admin" asp-controller="Restaurants" asp-action="Index">
                    <i class="bi bi-shop"></i> Restaurants
                </a>
                <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                    <i class="bi bi-tags-fill"></i> Categories
                </a>
                <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "FoodItems" ? "active" : "")" asp-area="Admin" asp-controller="FoodItems" asp-action="Index">
                    <i class="bi bi-egg-fried"></i> Food Items
                </a>
                <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                    <i class="bi bi-receipt"></i> Orders
                </a>
                <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")" asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <i class="bi bi-people-fill"></i> Users &amp; Roles
                </a>
                <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Coupons" ? "active" : "")" asp-area="Admin" asp-controller="Coupons" asp-action="Index">
                    <i class="bi bi-ticket-perforated-fill"></i> Coupons
                </a>
                <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reviews" ? "active" : "")" asp-area="Admin" asp-controller="Reviews" asp-action="Index">
                    <i class="bi bi-star-half"></i> Reviews
                </a>
                <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" asp-area="Admin" asp-controller="Reports" asp-action="Index">
                    <i class="bi bi-graph-up-arrow"></i> Sales Reports
                </a>
            </nav>

            <div class="mt-auto px-2 pt-4 border-top">
                <a class="btn btn-outline-dark btn-sm rounded-pill w-100 mb-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-arrow-left me-1"></i> Public Website
                </a>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill w-100">
                        <i class="bi bi-box-arrow-right me-1"></i> Log Out
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
