@model FoodExpress.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Overview & Metrics";
}

<div class="py-2">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">System Dashboard</h2>
            <p class="text-muted mb-0">High-level statistics, financial summaries, and platform activity.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-area="Admin" asp-controller="FoodItems" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3">
                <i class="bi bi-plus-lg me-1"></i> Add Food Item
            </a>
            <a asp-area="Admin" asp-controller="Restaurants" asp-action="Create" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                <i class="bi bi-plus-lg me-1"></i> Add Restaurant
            </a>
        </div>
    </div>

    <!-- KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Total Revenue</span>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-2">
                        <i class="bi bi-currency-rupee fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-0">₹@Model.TotalRevenue.ToString("F2")</h3>
                <span class="text-success small mt-2"><i class="bi bi-arrow-up-short"></i> Settled payments</span>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Total Orders</span>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2">
                        <i class="bi bi-receipt fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-0">@Model.TotalOrders</h3>
                <span class="text-muted small mt-2">@Model.CompletedOrders completed &bull; @Model.CancelledOrders cancelled</span>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Pending Orders</span>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-2">
                        <i class="bi bi-hourglass-split fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-0">@Model.PendingOrders</h3>
                <span class="text-warning small mt-2">Requires kitchen attention</span>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Active Kitchens</span>
                    <div class="rounded-circle bg-info bg-opacity-10 text-info p-2">
                        <i class="bi bi-shop fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-0">@Model.TotalRestaurants</h3>
                <span class="text-muted small mt-2">@Model.TotalFoodItems dishes listed</span>
            </div>
        </div>
    </div>

    <!-- Recent Orders & Top Selling Dishes -->
    <div class="row g-4">
        <!-- Recent Orders Table -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Recent Orders</h5>
                    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">
                        View All Orders &rarr;
                    </a>
                </div>

                @if (!Model.RecentOrders.Any())
                {
                    <p class="text-muted small py-4 text-center">No orders have been placed yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle table-hover mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Order #</th>
                                    <th>Customer</th>
                                    <th>Restaurant</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                @foreach (var o in Model.RecentOrders)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">#@o.Id</td>
                                        <td>@(o.User?.FullName ?? "User")</td>
                                        <td>@o.Restaurant?.Name</td>
                                        <td class="fw-bold">₹@o.TotalAmount.ToString("F2")</td>
                                        <td>
                                            <span class="badge @(o.OrderStatus == OrderStatus.Delivered ? "bg-success" : (o.OrderStatus == OrderStatus.Pending ? "bg-warning text-dark" : "bg-primary")) rounded-pill">
                                                @o.OrderStatus
                                            </span>
                                        </td>
                                        <td>
                                            <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id" class="btn btn-xs btn-outline-primary rounded-pill px-2 py-1">
                                                Manage
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Top Selling Dishes -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <h5 class="fw-bold mb-3">Top Selling Dishes</h5>
                @if (!Model.TopSellingFoods.Any())
                {
                    <p class="text-muted small py-4 text-center">No order item records yet.</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.TopSellingFoods)
                        {
                            <div class="list-group-item px-0 py-2 d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="fw-bold text-dark small">@item.Name</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">@item.Restaurant?.Name</div>
                                </div>
                                <span class="badge bg-light text-primary rounded-pill fw-bold">
                                    ₹@item.Price.ToString("F2")
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
