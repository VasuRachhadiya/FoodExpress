@model FoodExpress.Models.FoodItem
@{
    ViewData["Title"] = "Add Food Item";
    var restaurants = ViewBag.Restaurants as List<FoodExpress.Models.Restaurant> ?? new();
    var categories = ViewBag.Categories as List<FoodExpress.Models.FoodCategory> ?? new();
}

<div class="py-2">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-4">
                <a asp-action="Index" class="text-decoration-none text-muted small"><i class="bi bi-arrow-left"></i> Back to Food Items</a>
                <h2 class="fw-bold mb-1 mt-2">Add New Food Item</h2>
                <p class="text-muted mb-0">List a new dish in restaurant menus.</p>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label small fw-semibold">Dish Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control rounded-3" placeholder="e.g. Truffle Mushroom Burger" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label small fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="Ingredients, recipe notes, taste profile..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label small fw-semibold">Price (₹) <span class="text-danger">*</span></label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control rounded-3" placeholder="199.00" required />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label small fw-semibold">Category <span class="text-danger">*</span></label>
                            <select asp-for="CategoryId" class="form-select rounded-3" asp-items="ViewBag.CategoryId" required>
                                <option value="">-- Select Category --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RestaurantId" class="form-label small fw-semibold">Restaurant <span class="text-danger">*</span></label>
                        <select asp-for="RestaurantId" class="form-select rounded-3" asp-items="ViewBag.RestaurantId" required>
                            <option value="">-- Select Restaurant --</option>
                            @foreach (var res in restaurants)
                            {
                                <option value="@res.Id">@res.Name (@res.City)</option>
                            }
                        </select>
                        <span asp-validation-for="RestaurantId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold">Dish Photo</label>
                        <input type="file" name="imageFile" class="form-control rounded-3" accept="image/*" />
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="IsAvailable" id="isAvailCheck" checked>
                        <label class="form-check-label small fw-semibold" for="isAvailCheck">
                            Currently Available for Ordering
                        </label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-5 py-2">
                            Create Food Item
                        </button>
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4 py-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
