@model FoodExpress.Models.FoodItem
@{
    ViewData["Title"] = $"Delete {Model.Name}";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
            <div class="rounded-circle bg-danger bg-opacity-10 text-danger d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 70px; height: 70px;">
                <i class="bi bi-trash fs-2"></i>
            </div>
            <h3 class="fw-bold mb-1">Delete Menu Item?</h3>
            <p class="text-muted mb-4">Are you sure you want to permanently delete this food item from your menu? This action cannot be undone.</p>

            <div class="card bg-light border-0 rounded-3 p-3 text-start mb-4">
                <div class="d-flex align-items-center gap-3">
                    <img src="@(string.IsNullOrEmpty(Model.Image) ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=100" : Model.Image)" 
                         class="rounded-3" style="width: 60px; height: 60px; object-fit: cover;" alt="@Model.Name" />
                    <div>
                        <h5 class="fw-bold text-dark mb-0">@Model.Name</h5>
                        <span class="text-muted small">@(Model.Category?.Name) • ₹@Model.Price.ToString("F2")</span>
                        <div class="small text-secondary">@(Model.Restaurant?.Name)</div>
                    </div>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="d-flex justify-content-center gap-3">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger rounded-pill px-4">Yes, Delete Item</button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
            </form>
        </div>
    </div>
</div>
