@model IEnumerable<FoodExpress.Models.FoodItem>
@{
    ViewData["Title"] = "My Food Menu";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Food Menu Items</h2>
        <p class="text-muted mb-0">Manage your dishes, recipes, pricing, and live kitchen availability.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
        <i class="bi bi-plus-circle me-1"></i> Add New Dish
    </a>
</div>

<!-- Search & Filter Bar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" name="search" value="@Context.Request.Query["search"]" class="form-control form-control-sm" placeholder="Search dish name or description..." />
            </div>
            <div class="col-md-3">
                <select name="restaurantId" class="form-select form-select-sm" asp-items="ViewBag.OwnedRestaurants">
                    <option value="">-- All My Restaurants --</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="categoryId" class="form-select form-select-sm" asp-items="ViewBag.Categories">
                    <option value="">-- All Categories --</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Food Items Grid -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Dish</th>
                        <th>Restaurant</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Availability</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-egg-fried fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                No food items found. Click "Add New Dish" to build your menu!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@(string.IsNullOrEmpty(item.Image) ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=100" : item.Image)" 
                                             class="rounded-3" style="width: 50px; height: 50px; object-fit: cover;" alt="@item.Name" />
                                        <div>
                                            <div class="fw-bold text-dark">@item.Name</div>
                                            <div class="small text-muted text-truncate" style="max-width: 250px;">@item.Description</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-medium text-dark"><i class="bi bi-shop me-1 text-primary"></i> @(item.Restaurant?.Name)</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@(item.Category?.Name)</span>
                                </td>
                                <td class="fw-bold text-dark fs-6">
                                    ₹@item.Price.ToString("F2")
                                </td>
                                <td>
                                    <form asp-action="ToggleAvailability" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="badge @(item.IsAvailable ? "bg-success" : "bg-danger") border-0 px-3 py-2 rounded-pill" title="Click to toggle">
                                            @(item.IsAvailable ? "Available" : "Sold Out")
                                        </button>
                                    </form>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-2">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
