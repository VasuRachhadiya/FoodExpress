<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FoodExpress Owner</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Sidebar -->
            <div class="col-lg-2 dashboard-sidebar p-3 d-none d-lg-block">
                <div class="d-flex align-items-center mb-4 px-2 pt-2">
                    <span class="brand-icon me-2 d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-3">
                        <i class="bi bi-shop"></i>
                    </span>
                    <div>
                        <div class="fw-bold text-dark fs-5 lh-1">Food<span class="text-primary">Express</span></div>
                        <span class="badge bg-primary rounded-pill mt-1" style="font-size: 0.65rem;">PARTNER PORTAL</span>
                    </div>
                </div>

                <nav class="nav flex-column mb-4">
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Owner" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid-1x2-fill"></i> Dashboard
                    </a>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Restaurants" ? "active" : "")" asp-area="Owner" asp-controller="Restaurants" asp-action="Index">
                        <i class="bi bi-shop-window"></i> My Restaurants
                    </a>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "FoodItems" ? "active" : "")" asp-area="Owner" asp-controller="FoodItems" asp-action="Index">
                        <i class="bi bi-egg-fried"></i> Food Menu Items
                    </a>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")" asp-area="Owner" asp-controller="Orders" asp-action="Index">
                        <i class="bi bi-receipt"></i> Orders
                    </a>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reviews" ? "active" : "")" asp-area="Owner" asp-controller="Reviews" asp-action="Index">
                        <i class="bi bi-star-half"></i> Customer Reviews
                    </a>
                </nav>

                <hr class="text-secondary opacity-25" />

                <div class="px-2">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary w-100 rounded-pill mb-2">
                        <i class="bi bi-house-door me-1"></i> Customer Storefront
                    </a>
                    <a asp-area="" asp-controller="Profile" asp-action="Index" class="btn btn-sm btn-outline-secondary w-100 rounded-pill mb-2">
                        <i class="bi bi-person-gear me-1"></i> My Profile
                    </a>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-pill">
                            <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                        </button>
                    </form>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="col-lg-10 p-3 p-md-4 main-content">
                <!-- Mobile Header -->
                <header class="d-flex justify-content-between align-items-center bg-white rounded-4 shadow-sm mb-4 d-lg-none p-3">
                    <div class="d-flex align-items-center">
                        <button class="btn btn-light me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#ownerMobileSidebar">
                            <i class="bi bi-list fs-4"></i>
                        </button>
                        <span class="fw-bold text-dark fs-6">Food<span class="text-primary">Express</span> <span class="badge bg-primary ms-1" style="font-size: 0.65rem;">PARTNER</span></span>
                    </div>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-light rounded-pill px-3">
                        <i class="bi bi-globe me-1"></i> Live Site
                    </a>
                </header>

                <!-- Feedback Notifications -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Owner Mobile Offcanvas Sidebar -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="ownerMobileSidebar" aria-labelledby="ownerMobileSidebarLabel">
        <div class="offcanvas-header border-bottom">
            <div class="d-flex align-items-center">
                <span class="brand-icon me-2 d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-3">
                    <i class="bi bi-shop"></i>
                </span>
                <div>
                    <div class="fw-bold text-dark fs-5 lh-1" id="ownerMobileSidebarLabel">Food<span class="text-primary">Express</span></div>
                    <span class="badge bg-primary rounded-pill mt-1" style="font-size: 0.65rem;">PARTNER PORTAL</span>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column p-3">
            <nav class="nav flex-column mb-4">
                <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Owner" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-grid-1x2-fill"></i> Dashboard
                </a>
                <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Restaurants" ? "active" : "")" asp-area="Owner" asp-controller="Restaurants" asp-action="Index">
                    <i class="bi bi-shop-window"></i> My Restaurants
                </a>
                <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "FoodItems" ? "active" : "")" asp-area="Owner" asp-controller="FoodItems" asp-action="Index">
                    <i class="bi bi-egg-fried"></i> Food Menu Items
                </a>
                <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")" asp-area="Owner" asp-controller="Orders" asp-action="Index">
                    <i class="bi bi-receipt"></i> Orders
                </a>
                <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reviews" ? "active" : "")" asp-area="Owner" asp-controller="Reviews" asp-action="Index">
                    <i class="bi bi-star-half"></i> Customer Reviews
                </a>
            </nav>

            <div class="mt-auto px-2 pt-4 border-top">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary w-100 rounded-pill mb-2">
                    <i class="bi bi-house-door me-1"></i> Customer Storefront
                </a>
                <a asp-area="" asp-controller="Profile" asp-action="Index" class="btn btn-sm btn-outline-secondary w-100 rounded-pill mb-2">
                    <i class="bi bi-person-gear me-1"></i> My Profile
                </a>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-pill">
                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
