@model IEnumerable<FoodExpress.Models.Order>
@{
    ViewData["Title"] = "Incoming Orders";
    var restaurants = ViewBag.Restaurants as List<FoodExpress.Models.Restaurant> ?? new List<FoodExpress.Models.Restaurant>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Incoming Restaurant Orders</h2>
        <p class="text-muted mb-0">Track kitchen preparation, delivery handover, and order receipts.</p>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Order Status</label>
                <select name="status" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<FoodExpress.Models.OrderStatus>()">
                    <option value="">-- All Statuses --</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Restaurant</label>
                <select name="restaurantId" class="form-select form-select-sm">
                    <option value="">-- All My Restaurants --</option>
                    @foreach (var r in restaurants)
                    {
                        <option value="@r.Id" selected="@(ViewBag.SelectedRestaurantId == r.Id)">@r.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2 mt-auto">
                <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Orders Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Order #</th>
                        <th>Date &amp; Time</th>
                        <th>Restaurant</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                No orders received matching these filters.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">#@order.Id</td>
                                <td class="small text-muted">
                                    @order.OrderDate.ToString("dd MMM yyyy")<br />
                                    <span class="text-secondary opacity-75">@order.OrderDate.ToString("hh:mm tt")</span>
                                </td>
                                <td>
                                    <span class="fw-medium text-dark"><i class="bi bi-shop me-1 text-primary"></i> @(order.Restaurant?.Name)</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@(order.User?.FullName ?? "Customer")</div>
                                    <div class="small text-muted">@(order.PhoneNumber ?? order.User?.PhoneNumber)</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@order.OrderItems.Count items</span>
                                </td>
                                <td class="fw-bold text-dark">₹@order.TotalAmount.ToString("F2")</td>
                                <td>
                                    @{
                                        var badge = order.OrderStatus switch
                                        {
                                            FoodExpress.Models.OrderStatus.Pending => "bg-warning text-dark",
                                            FoodExpress.Models.OrderStatus.Confirmed => "bg-info text-dark",
                                            FoodExpress.Models.OrderStatus.Preparing => "bg-primary",
                                            FoodExpress.Models.OrderStatus.OutForDelivery => "bg-indigo text-white",
                                            FoodExpress.Models.OrderStatus.Delivered => "bg-success",
                                            FoodExpress.Models.OrderStatus.Cancelled => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badge rounded-pill px-2 py-1">@order.OrderStatus</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        Manage
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
